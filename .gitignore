# environments and caches
.venv/
.venv-htr
__pycache__/
*.pyc
data/*/training/cache/

# images: scans and every crop are re-creatable from the archive (page_urls.txt + sha256s)
*.jpg
*.jpeg
*.png
data/*/pages/
data/*/rows/
data/*/crops/
data/*/debug/
data/*/zoom_a/
data/*/zoom_b/
data/*/processed/rows/
data/*/training/proposals*/
data/*/training/exports/
data/*/training/runs/*.log
site/review/rows
site/review/pages
# per-shard and baseline prediction runs are intermediate
data/*/training/predictions/*shard*/
data/*/training/baseline/
# first-stage line proposals for other years: superseded by *_v2 and reproducible
data/*/training/line_proposals_years.json
# keep only the final merged prediction runs
data/*/training/predictions/*
!data/*/training/predictions/*-merged/
# personal/family research notes and the superseded family map stay local
docs/2026-11-10-original-status.md
docs/CLAUDE_HANDOFF.md
site/index.html
# site/book/ is the reading GUI (confirmed by Anna). Page images are regenerated by
# `site/book/build_book.py --images` from the scans; the museum textiles (CC BY 4.0) are kept.
site/book*/img/pages/
# The page images of the two published books are committed, so the book on samogitia.brezgis.com
# has its pages (Anna, 2026-11-11: non-commercial publication, as NOC-NC allows). The other books
# stay out until the site has room: Pages allows about 1 GB and five books of scans are more.
!site/book/img/pages/
!site/book/img/pages/*.jpg
!site/book-1896-1902/img/pages/
!site/book-1896-1902/img/pages/*.jpg
!site/book*/img/cloth-*.jpg
!site/book*/img/src/
!site/book*/img/src/*.jpg
# bulk image folders may be links to a data drive (see docs/NIGHT_LOG.md, 2026-11-11)
data/*/pages
data/*/processed/rows
data/*/training/proposals_years_v2
data/*/training/proposals_v2
data/*/rows
