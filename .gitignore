# environments and caches
.venv/
.venv-htr
__pycache__/
*.pyc
data/*/training/cache/

# images: scans and every crop are re-creatable from the archive (page_urls.txt + sha256s)
*.jpg
*.jpeg
*.png
data/*/pages/
data/*/rows/
data/*/crops/
data/*/debug/
data/*/zoom_a/
data/*/zoom_b/
data/*/processed/rows/
data/*/training/proposals*/
data/*/training/exports/
data/*/training/runs/*.log
site/review/rows
site/review/pages
# per-shard and baseline prediction runs are intermediate
data/*/training/predictions/*shard*/
data/*/training/baseline/
# first-stage line proposals for other years: superseded by *_v2 and reproducible
data/*/training/line_proposals_years.json
# keep only the final merged prediction runs
data/*/training/predictions/*
!data/*/training/predictions/*-merged/
# personal/family research notes and the superseded family map stay local
docs/2026-11-10-original-status.md
docs/CLAUDE_HANDOFF.md
site/index.html
# site/book/ is the reading GUI (confirmed by Anna). Page images are regenerated by
# `site/book/build_book.py --images` from the scans; the museum textiles (CC BY 4.0) are kept.
site/book*/img/pages/
# Page images are not in this repository: the published site loads them from the Hugging Face
# dataset brezgis/samogita-records (Anna, 2026-11-15). site/make_pages_webp.py writes the WebP
# copies that are uploaded there; they and the JPEGs they are made from stay on disk only.
# the site's icon (site/make_favicon.py)
!site/favicon-32.png
!site/apple-touch-icon.png
# small copies of every book's pages for the opening riffle (site/make_thumbs.py), about 45 MB in all: published for every book
!site/book*/img/thumbs/
!site/book*/img/thumbs/*.webp
!site/book*/img/cloth-*.jpg
!site/book*/img/src/
!site/book*/img/src/*.jpg
# bulk image folders may be links to a data drive (see docs/NIGHT_LOG.md, 2026-11-11)
data/*/pages
data/*/processed/rows
data/*/training/proposals_years_v2
data/*/training/proposals_v2
data/*/rows
# scans as downloaded, when pages/ holds an enlarged copy (Salantai: 3200 px scans scaled x1.5 for the layout step)
data/*/pages_orig
data/download_queue.status.json
# the one cloth the site uses and the two museum photographs shown in its credits (CC BY 4.0)
!site/textiles/cloth-plunge.jpg
!site/textiles/src/
!site/textiles/src/1056757085.jpg
!site/textiles/src/914006288.jpg
# the same for books of other parishes, whose folders are named <parish>-<years> (site/salantai-1856-1862)
site/*-[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]/img/pages/
!site/*-[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]/img/cloth-*.jpg
!site/*-[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]/img/src/
!site/*-[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]/img/src/*.jpg
