[{"id": "0074_L4_baptism_01", "text": "Тысяча восемсотъ пятьдесятъ девятаго", "status": "image_checked", "note": ""}, {"id": "0074_L4_baptism_02", "text": "[г?]ода Іюля второго дня въ Салантовскомъ", "status": "draft", "note": "first glyph at left edge only partly visible; mark above 'второго' looks like a stray stroke"}, {"id": "0074_L4_baptism_03", "text": "Приходскомъ Р.К. Костелѣ Викарны[мъ?]", "status": "draft", "note": "end of Викарнымъ under ink blot/tear"}, {"id": "0074_L4_baptism_04", "text": "Ксендзомъ Іоанномъ [Арвасевичемъ?]", "status": "draft", "note": "priest surname"}, {"id": "0074_L4_baptism_05", "text": "окрещено дитя именами Марія -", "status": "draft", "note": "dash after Марія: filler or link to Дорота on next line"}, {"id": "0074_L4_baptism_06", "text": "Дорота, со всѣми обрядами Таин-", "status": "image_checked", "note": "'совсѣми' written joined"}, {"id": "0074_L4_baptism_07", "text": "ства.", "status": "draft", "note": "a separate dot further right looks like a speck, not transcribed"}, {"id": "0074_L4_parents_01", "text": "[Прускаго?] [поданнаго?] Андрея", "status": "draft", "note": "single or double д in поданнаго unclear"}, {"id": "0074_L4_parents_02", "text": "и Изабелли урожденной [Н?]и", "status": "draft", "note": "capital at line end looks like К or Н; godmother below is Никонтовною"}, {"id": "0074_L4_parents_03", "text": "[к?]онтовны Курцовъ Закон", "status": "draft", "note": "left part torn; no visible hyphen after Закон; surname Курцовъ uncertain"}, {"id": "0074_L4_parents_04", "text": "ныхъ Супруговъ дочь родив-", "status": "image_checked", "note": ""}, {"id": "0074_L4_parents_05", "text": "шась 1859 года Іюля 2го дня", "status": "draft", "note": "reads 'шась' (no я visible); ш carries the under-stroke"}, {"id": "0074_L4_parents_06", "text": "въ деревни Микит[ахъ?] Са-", "status": "draft", "note": "village name"}, {"id": "0074_L4_parents_07", "text": "", "status": "rejected_crop", "note": "tear plus only the tops of the next line's letters; no complete text"}, {"id": "0074_L4_parents_08", "text": "лантовскаго Прихода. -", "status": "image_checked", "note": ""}, {"id": "0074_L4_godparents_01", "text": "Воспріемниками были", "status": "image_checked", "note": "stray mark at left edge not transcribed"}, {"id": "0074_L4_godparents_02", "text": "Крестьянъ Андре[й?]", "status": "draft", "note": "breve on й not visible"}, {"id": "0074_L4_godparents_03", "text": "Маа[т?]ъ. съ Доротою-", "status": "draft", "note": "godfather surname; 4th letter т-like (m shape) or ж"}, {"id": "0074_L4_godparents_04", "text": "[Никонтовною?] дѣви-", "status": "draft", "note": "godmother surname; capital Н written like N"}, {"id": "0074_L4_godparents_05", "text": "цею. -", "status": "image_checked", "note": ""}, {"id": "0104_L6_baptism_01", "text": "[станцы?], Со всѣми обрядами Таинства. -", "status": "draft", "note": "end of previous entry's name; punctuation after Таинства could be comma"}, {"id": "0104_L6_baptism_02", "text": "Тысяча восемсотъ шестьдесятъ перваго года", "status": "image_checked", "note": "stroke under ш is part of the letter"}, {"id": "0104_L6_baptism_03", "text": "Мая шест[ь?]надцатаго дня въ Са-", "status": "draft", "note": "leading flourish not transcribed; possible ь after шест"}, {"id": "0104_L6_baptism_04", "text": "лантовскомъ Приходскомъ Р.К. Косте-", "status": "image_checked", "note": ""}, {"id": "0104_L6_baptism_05", "text": "лѣ Мѣстнымъ Викарнымъ", "status": "draft", "note": "capital vs lowercase М in Мѣстнымъ uncertain"}, {"id": "0104_L6_baptism_06", "text": "Ксендзомъ Іосифомъ Залескимъ -", "status": "draft", "note": "priest surname; long filler stroke"}, {"id": "0104_L6_baptism_07", "text": "окрещено дитя именами Антоній", "status": "draft", "note": "a dash beyond the column rule at right not transcribed (may be neighbouring cell)"}, {"id": "0104_L6_baptism_08", "text": "Янъ, Со всѣми обрядами Таин-", "status": "image_checked", "note": ""}, {"id": "0104_L6_baptism_09", "text": "ства. -"